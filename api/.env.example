# Supabase → Project Settings → Database → Connection string → URI
# 部署在 Vercel（serverless），一律用 6543 Supavisor transaction pooler，不可用 5432 直連。
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# JWT 簽章密鑰，至少 32 字元。產生：openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 允許的前端來源，逗號分隔。部署後補上 Vercel 前端網址。
CORS_ORIGIN=http://localhost:5173

# 僅本機長駐用，Vercel 不需要
PORT=8787

# db:seed 建立的初始帳號。
# SEED_ADMIN_PASSWORD 是三個啟用帳號的初始密碼，正式部署務必改成隨機值
# （產生：openssl rand -base64 12），首次登入後在 App 內自行更換。
SEED_ADMIN_ACCOUNT=dad
SEED_ADMIN_NAME=先生
SEED_ADMIN_CODE=123456
SEED_ADMIN_PASSWORD=1234

# Vercel Cron 呼叫 /api/cron/* 的憑證，至少 16 字元（openssl rand -hex 16）。
# 未設定時該端點一律回 403。本機測試可用 curl 帶同一組值。
CRON_SECRET=

# 家用 LINE 機器人（Messaging API）：每月 10、20、30 號在家庭群組發剩餘額度。
# LINE Developers → 該 channel → Messaging API 分頁最下方 → Channel access token (long-lived)。
# LINE_NOTIFY_TO 填家庭群組 ID（C 開頭）；測試可先填 Basic settings 最下方的 Your user ID（U 開頭）。
# 兩者缺一時排程只試算訊息、不發送。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_TO=

# 每週備份的上傳目標。Supabase → Project Settings → API 取得 URL 與 service_role key。
# bucket 需先在 Storage 手動建立，且務必保持 private（備份含密碼雜湊）。
# 兩者留空時 /api/cron/backup 只試算不上傳，可用於本機驗證匯出內容。
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
BACKUP_BUCKET=ledger-backups
